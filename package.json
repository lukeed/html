{
  "name": "@lukeed/html",
  "version": "0.0.0",
  "repository": "lukeed/html",
  "description": "A fast HTML parser with source offsets and CSS selectors",
  "type": "module",
  "license": "MIT",
  "author": "Luke Edwards <luke.edwards05@gmail.com> (https://lukeed.com)",
  "scripts": {
    "build": "bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --outdir dist --target node --packages external --minify",
    "build:types": "tsc -p tsconfig.build.json",
    "bench": "bun bench/index.ts",
    "corpus": "bun bench/corpus.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "html",
    "parser",
    "selector",
    "dom"
  ],
  "dependencies": {
    "entities": "8.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "css-select": "7.0.0",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0",
    "mitata": "1.0.34",
    "node-html-parser": "9.0.5",
    "parse5": "8.0.1",
    "typescript": "7.0.2",
    "ultrahtml": "1.7.0"
  }
}
