{
  "name": "@lukeed/html",
  "version": "0.0.0",
  "repository": "lukeed/html",
  "description": "A fast HTML parser with source offsets and CSS selectors",
  "type": "module",
  "license": "MIT",
  "author": "Luke Edwards <luke.edwards05@gmail.com> (https://lukeed.com)",
  "scripts": {
    "build": "bun build.ts",
    "bench": "bun run bench:bun && bun run bench:node && bun bench/report.ts",
    "corpus": "bun bench/corpus.ts",
    "bench:node": "bun build bench/index.ts --target node --packages external --outfile bench/.node.js && node --expose-gc bench/.node.js",
    "compare": "bun bench/compare.ts",
    "bench:bun": "bun bench/index.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mutable": {
      "types": "./dist/mutable/index.d.ts",
      "default": "./dist/mutable/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "html",
    "parser",
    "selector",
    "dom"
  ],
  "dependencies": {
    "entities": "8.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "22.20.5",
    "css-select": "7.0.0",
    "dom-serializer": "3.1.1",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0",
    "lol-html": "2.3.0",
    "mitata": "1.0.34",
    "node-html-parser": "9.0.5",
    "parse5": "8.0.1",
    "typescript": "7.0.2",
    "ultrahtml": "1.7.0"
  }
}
