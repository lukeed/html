{
  "name": "@lukeed/html",
  "version": "0.0.0",
  "repository": "lukeed/html",
  "description": "A fast HTML parser with source offsets and CSS selectors",
  "type": "module",
  "license": "MIT",
  "author": "Luke Edwards <luke.edwards05@gmail.com> (https://lukeed.com)",
  "scripts": {
    "build": "bun build.ts",
    "bench": "bun run --cwd bench"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mutable": {
      "types": "./dist/mutable/index.d.ts",
      "default": "./dist/mutable/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "html",
    "parser",
    "selector",
    "dom"
  ],
  "dependencies": {
    "entities": "^8.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "22.20.5",
    "css-select": "7.0.0",
    "domhandler": "6.0.1",
    "htmlparser2": "12.0.0",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "bench"
  ]
}
